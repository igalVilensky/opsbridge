generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Case {
  id                  String            @id @default(cuid())
  subject             String
  originalMessage     String
  customerEmail       String?
  orderId             String?
  phoneNumber         String?
  department          String
  priority            String            @default("MEDIUM")
  status              String            @default("NEW")
  externalRequestId   String?           @unique
  aiSummary           String?
  suggestedAction     String?
  draftResponse       String?
  approvedResponse    String?
  rejectionReason     String?
  lastError           String?
  urgentWebhookSentAt DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  customerSnapshot    CustomerSnapshot?
  orderSnapshot       OrderSnapshot?
  callSnapshot        CallSnapshot?

  events          CaseEvent[]
  enrichmentRuns  EnrichmentRun[]
  integrationRuns IntegrationRun[]
}

model CaseEvent {
  id        String   @id @default(cuid())
  caseId    String
  eventType String
  message   String
  metadata  String?
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model CustomerSnapshot {
  id                 String   @id @default(cuid())
  caseId             String   @unique
  externalCustomerId String
  name               String
  email              String
  phone              String?
  company            String?
  status             String
  rawData            String
  createdAt          DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model OrderSnapshot {
  id               String   @id @default(cuid())
  caseId           String   @unique
  externalOrderId  String
  orderStatus      String
  shippingStatus   String
  shippingProvider String?
  trackingNumber   String?
  rawData          String
  createdAt        DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CallSnapshot {
  id              String   @id @default(cuid())
  caseId          String   @unique
  externalCallId  String
  calledAt        DateTime
  durationSeconds Int
  callStatus      String
  note            String?
  rawData         String
  createdAt       DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model IntegrationRun {
  id              String    @id @default(cuid())
  caseId          String
  enrichmentRunId String?
  integrationName String
  status          String
  errorMessage    String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  case          Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  enrichmentRun EnrichmentRun? @relation(fields: [enrichmentRunId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([enrichmentRunId])
  @@index([integrationName])
  @@index([status])
}

model EnrichmentRun {
  id        String   @id @default(cuid())
  caseId    String
  startedAt DateTime @default(now())

  case            Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  integrationRuns IntegrationRun[]

  @@index([caseId])
}
